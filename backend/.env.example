# Copy this file to ".env" (same folder) and change values if needed.
# ".env" is ignored by git. Never commit real keys or tokens.

# --- Ollama ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:1.7b

# CPU-only PCs are slow: allow up to 5 minutes and cap the reply length.
OLLAMA_TIMEOUT=300
OLLAMA_MAX_TOKENS=350

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (optional, defaults to backend/shopmate.db) ---
# SHOPMATE_DB=
